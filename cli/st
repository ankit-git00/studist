#!/usr/bin/bash 

set -euo pipefail

API=""

usage(){

cat <<EOF
Usage: st <command> [args]
EOF
}

cmd_start(){
    local minutes="${1:-}"
    
    if [[ -z "$minutes" ]]; then
        echo "Please specify the duration in minutes."
        exit 1
    fi

    echo "Starting for $minutes minutes..."
}

main(){
    local cmd="${1:-help}"
    shift || true
    echo "Starting the script..."

    case "$cmd" in 
        start)
            cmd_start "$@";;
        help)
            usage
            ;;
        *)
            echo "Unknown command: $cmd"
            usage
            exit 1
            ;;
    esac
}

main "$@"



